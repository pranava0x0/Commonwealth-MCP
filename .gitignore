.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Local-only material: reference notes kept outside this project, and
# AI-coding-tool config (editor/agent launch configs, session state). None
# of it is project content — every command the README runs is documented in
# plain shell form, so nothing here depends on any of it.
base-files/
.claude/
.codex/
.cursor/
.agents/
.vscode/

# uv writes this when a contributor syncs a venv. Dependencies are already
# exact-pinned in pyproject.toml per design/0003 (this is an application
# tree, not a published library), so a lockfile would be a second, silently
# diverging source of truth.
uv.lock

# Raw research output: ~25 MB of API snapshots (the MCP registry crawl alone
# is 23 MB) that the stdlib scripts in tools/ regenerate on demand. It is
# evidence, not source — RESEARCH.md cites it, and its "Reproducing the
# collection" section rebuilds it. Kept out of the tree so a clone is small.
research/raw/

# Local working backlog. Maintainer-facing notes — which spec ruling is
# owed, which one-line fixes to make next time a file is open — that would
# be noise in the public issue tracker. It points at GitHub issue numbers
# rather than copying them, so the issues stay the record and this stays
# the reading order.
backlog.md
